{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 104,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Row 1: Edge & Ingress Health (Cloudflare & Istio Gateway)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Edge Ingress Traffic Volume (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"fitbuddy-app\"}[1m]))",
          "legendFormat": "Total Ingress RPS"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line" } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Core API Latency Percentiles (P50, P95, P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"fitbuddy-app\"}[1m])) by (le)) * 1000",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"fitbuddy-app\"}[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (SLA: 250ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"fitbuddy-app\"}[1m])) by (le)) * 1000",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 5, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "HTTP 5xx Error Rate % (SLA < 0.1%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{job=\"fitbuddy-app\", status=~\"5..\"}[1m])) / sum(rate(http_requests_total{job=\"fitbuddy-app\"}[1m]))) * 100",
          "legendFormat": "5xx Ratio %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 200,
      "title": "Row 2: Flagger Progressive Canary Mesh Telemetry",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "title": "Flagger Ingress Traffic Weight Split (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "flagger_canary_weight{name=\"fitbuddy-core-canary\"}",
          "legendFormat": "Canary Traffic Weight %"
        },
        {
          "expr": "100 - flagger_canary_weight{name=\"fitbuddy-core-canary\"}",
          "legendFormat": "Primary Traffic Weight %"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "title": "Primary vs. Canary P95 Latency Comparison",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{pod=~\"fitbuddy-app-primary-.*\"}[1m])) by (le)) * 1000",
          "legendFormat": "Primary P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{pod=~\"fitbuddy-app-canary-.*\"}[1m])) by (le)) * 1000",
          "legendFormat": "Canary P95 Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 300,
      "title": "Row 3: Compute & Storage Tier (FastAPI, Celery, Redis, PostgreSQL)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 19 },
      "id": 8,
      "title": "Celery Active Worker Pod Count",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Running\", pod=~\"fitbuddy-celery-worker-.*\"})",
          "legendFormat": "Active Worker Pods"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 19 },
      "id": 9,
      "title": "Celery Queue Backlog vs. DLQ Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "celery_queue_length{queue=\"workout_generation\"}",
          "legendFormat": "Active Backlog"
        },
        {
          "expr": "rate(celery_task_dlq_total[1m])",
          "legendFormat": "DLQ Tasks/sec"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 19 },
      "id": 10,
      "title": "Redis Memory Utilization",
      "type": "timeseries",
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used Memory"
        },
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "Max Allocated Limit"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "id": 11,
      "title": "PostgreSQL Active Connections & Locks",
      "type": "timeseries",
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "Active Connections"
        },
        {
          "expr": "pg_stat_activity_count{state=\"idle in transaction\"}",
          "legendFormat": "Idle in Transaction (>30s SLA)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 400,
      "title": "Row 4: GenAI & Vision Pipeline (Gemini Pro/Flash, Circuit Breaker, MediaPipe)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "id": 12,
      "title": "GenAI Model Routing: Gemini 1.5 Pro vs. Flash",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(genai_model_requests_total{model=\"gemini-1.5-pro\"}[1m]))",
          "legendFormat": "Gemini 1.5 Pro (Primary)"
        },
        {
          "expr": "sum(rate(genai_model_requests_total{model=\"gemini-1.5-flash\"}[1m]))",
          "legendFormat": "Gemini 1.5 Flash (Fallback)"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "text": "CLOSED (Normal)" }, "1": { "color": "red", "text": "OPEN (Fallback Active)" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "id": 13,
      "title": "GenAI Circuit Breaker State Flag",
      "type": "stat",
      "targets": [
        {
          "expr": "genai_circuit_breaker_status",
          "legendFormat": "Circuit Breaker State"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": { "defaults": { "unit": "fps" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "id": 14,
      "title": "MediaPipe 33-Point Pose Inference FPS (Edge Client)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "avg(kinematic_pose_estimation_fps)",
          "legendFormat": "Average Edge FPS (Target >= 30 FPS)"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["fitbuddy", "production", "sre", "istio", "gemini"],
  "time": { "from": "now-1h", "to": "now" },
